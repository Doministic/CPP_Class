{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 26
  },

  "configurePresets": [
    {
      "name": "base",
      "displayName": "Base (VS2022)",
      "generator": "Visual Studio 17 2022",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "CMAKE_CXX_STANDARD": "14",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "YES"
      }
    },

    {
      "name": "singlefile",
      "inherits": "base",
      "displayName": "Sections 1–2 • Single-file build",
      "description": "Each .cpp with main() in the chosen class folder becomes its own executable.",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "BUILD_MODE":  "SingleFile"
      },
      "environment": {}
    },

    {
      "name": "section",
      "inherits": "base",
      "displayName": "Sections 3–9 • Whole-section build",
      "description": "Build entire section; requires a single main.cpp at the section root.",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "BUILD_MODE":  "Section"
      },
      "environment": {}
    }
  ],

  "buildPresets": [
    {
      "name": "singlefile-Debug",
      "displayName": "Single-file • Debug",
      "configurePreset": "singlefile",
      "configuration": "Debug"
    },
    {
      "name": "singlefile-Release",
      "displayName": "Single-file • Release",
      "configurePreset": "singlefile",
      "configuration": "Release"
    },
    {
      "name": "section-Debug",
      "displayName": "Whole-section • Debug",
      "configurePreset": "section",
      "configuration": "Debug"
    },
    {
      "name": "section-Release",
      "displayName": "Whole-section • Release",
      "configurePreset": "section",
      "configuration": "Release"
    }
  ],

  "workflowPresets": [
    {
      "name": "wf-singlefile-Debug",
      "displayName": "▶ Single-file Debug",
      "steps": [
        {
          "type": "configure",
          "name": "singlefile"
        },
        {
          "type": "build",
          "name": "singlefile-Debug"
        }
      ]
    },
    {
      "name": "wf-singlefile-Release",
      "displayName": "▶ Single-file Release",
      "steps": [
        {
          "type": "configure",
          "name": "singlefile"
        },
        {
          "type": "build",
          "name": "singlefile-Release"
        }
      ]
    },
    {
      "name": "wf-section-Debug",
      "displayName": "▶ Whole-section Debug",
      "steps": [
        {
          "type": "configure",
          "name": "section"
        },
        {
          "type": "build",
          "name": "section-Debug"
        }
      ]
    },
    {
      "name": "wf-section-Release",
      "displayName": "▶ Whole-section Release",
      "steps": [
        {
          "type": "configure",
          "name": "section"
        },
        {
          "type": "build",
          "name": "section-Release"
        }
      ]
    }
  ]
}
